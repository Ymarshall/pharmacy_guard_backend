# Copier vers .env et exporter les variables avant le démarrage.
# Ne jamais committer le fichier .env.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pharmacy_guarde_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

# Au moins 32 caractères, généré aléatoirement. Révoquer toute ancienne valeur.
JWT_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum

# Origines du back-office Angular et, si besoin, d'un autre front. Pas de *.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Profil production : coupe Swagger et les logs SQL.
# SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=true

GOOGLE_MAPS_API_KEY=
GOOGLE_VISION_ENABLED=false
GOOGLE_VISION_CREDENTIALS_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Premier administrateur, créé seulement s'il n'existe pas encore.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optionnel. Google Vision reste le moteur par défaut.
LLM_VISION_ENABLED=false
LLM_VISION_BASE_URL=
LLM_VISION_API_KEY=
LLM_VISION_MODEL=gpt-4o-mini

FILE_UPLOAD_DIR=uploads/duty-files
FILE_EXTRACTION_DIR=uploads/extractions
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60
TRUST_FORWARDED_FOR=false

# Seed du catalogue embarqué. Laisser à false en production (le JSON intégré réécrirait les pharmacies).
SEED_PHARMACIES_ENABLED=false

# Fenêtre de garde (optionnel). Relève à 08:00, fuseau Africa/Abidjan par défaut.
# DUTY_ZONE=Africa/Abidjan
# DUTY_HANDOVER_TIME=08:00
